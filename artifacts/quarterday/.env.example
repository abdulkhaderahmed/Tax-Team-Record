# Postgres connection string (Prisma). Replit provided this automatically;
# off Replit you'll need your own Postgres instance (e.g. Neon, Supabase, Railway, or local).
DATABASE_URL=

# Used for AI-assisted document extraction (src/lib/openai-client.ts).
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Clerk authentication (https://dashboard.clerk.com/).
# Add these to Replit secrets / your deployment environment; never commit real values.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
