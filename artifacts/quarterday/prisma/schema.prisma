generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organisation {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  entities            Entity[]
  auditEvents         AuditEvent[]
  manualObligations   ManualObligation[]
  sourceSystems       SourceSystem[]
  sourcePriorityRules SourcePriorityRule[]
  sourceConflicts     SourceConflict[]
  documents           Document[]
  reviewItems         ReviewItem[]
  actions             Action[]
  assumptions         Assumption[]
  tripwires           Tripwire[]
}

model User {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  email          String       @unique
  role           String       @default("member")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  auditEvents AuditEvent[]
}

model Entity {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  // Identification
  legalName            String
  companiesHouseNumber String?
  jurisdiction         String  @default("England & Wales")
  entityType           String?
  ukTaxResident        Boolean @default(true)

  // Corporation Tax
  corporationTaxUtr         String?
  accountingPeriodStart     DateTime?
  accountingPeriodEnd       DateTime?
  companiesHouseAccountsDue DateTime?
  ctReturnRequired          Boolean   @default(true)
  ctPaymentMethod           String?
  isLargeCompany            Boolean   @default(false)
  isVeryLargeCompany        Boolean   @default(false)
  taxableProfitsBand        String?

  // VAT
  vatRegistered         Boolean @default(false)
  vatRegistrationNumber String?
  vatQuarterEndMonth    Int?

  // Payroll & Employment
  payeRegistered Boolean @default(false)
  hasErs         Boolean @default(false)
  hasEmi         Boolean @default(false)
  p11dRequired   Boolean @default(false)
  psaRequired    Boolean @default(false)

  // R&D
  rdClaimExpected      Boolean @default(false)
  rdNotificationNeeded Boolean @default(false)
  rdAifNeeded          Boolean @default(false)

  // Capital Allowances
  capitalAllowancesActivity Boolean @default(false)
  fullExpensingRelevant     Boolean @default(false)
  aiaRelevant               Boolean @default(false)
  specialRatePoolRelevant   Boolean @default(false)

  // Group & International
  groupReliefRelevant     Boolean @default(false)
  lossesBroughtForward    Boolean @default(false)
  transferPricingRelevant Boolean @default(false)
  hasPillar2              Boolean @default(false)

  // Governance
  saoInScope                  Boolean @default(false)
  ccoInScope                  Boolean @default(false)
  publishedTaxStrategyInScope Boolean @default(false)

  // Ownership
  primaryTaxOwner String?
  financeOwner    String?
  payrollOwner    String?
  externalAdviser String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  obligations       Obligation[]
  auditEvents       AuditEvent[]
  manualObligations ManualObligation[]
  sourceConflicts   SourceConflict[]
  documents         Document[]
  reviewItems       ReviewItem[]
  actions           Action[]
  assumptions       Assumption[]
  tripwires         Tripwire[]
}

model ObligationRule {
  id          String   @id @default(cuid())
  ruleKey     String   @unique
  name        String
  description String
  appliesTo   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  obligations Obligation[]
}

model Obligation {
  id        String         @id @default(cuid())
  entityId  String
  entity    Entity         @relation(fields: [entityId], references: [id], onDelete: Cascade)
  ruleId    String
  rule      ObligationRule @relation(fields: [ruleId], references: [id])
  title     String
  dueDate   DateTime
  period    String
  status    String         @default("DRAFT")
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  auditEvents AuditEvent[]
}

model ManualObligation {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  entityId       String?
  entity         Entity?      @relation(fields: [entityId], references: [id], onDelete: SetNull)

  // Core
  regime             String
  obligationType     String
  description        String
  statutoryBasis     String?
  filingDeadline     DateTime?
  paymentDeadline    DateTime?
  internalTargetDate DateTime?
  recurrence         String?
  periodStart        DateTime?
  periodEnd          DateTime?
  source             String?

  // Ownership
  responsibleOwner String?
  accountableOwner String?
  consultedParty   String?
  informedParty    String?
  externalAdviser  String?

  // Status (7 separate dimensions)
  dataCompletenessStatus String @default("Not started")
  dataValidationStatus   String @default("Not started")
  technicalReviewStatus  String @default("Not started")
  approvalStatus         String @default("Not started")
  evidenceStatus         String @default("Not started")
  filingPaymentStatus    String @default("Not started")
  overallWorkflowStatus  String @default("Not started")

  // Evidence
  evidenceRequired    Boolean @default(false)
  evidenceDescription String?
  evidenceFileLink    String?
  evidenceOwner       String?

  // Risk & control
  riskLevel                    String?
  consequenceOfMissingDeadline String?
  openIssueBlocker             String?
  notes                        String?
  exceptionRequired            Boolean @default(false)

  // Source & audit
  sourceType              String?
  sourceDocumentReference String?
  sourcePageParagraph     String?
  createdBy               String?
  lastUpdatedBy           String?

  // Rules-pack / draft generation
  ruleId            String?
  calculationBasis  String?
  humanExplanation  String?
  draftReviewStatus String? // pending | activated | rejected | not_applicable
  draftNote         String?
  generationBatchId String?

  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sourceRef ObligationSourceRef?

  @@index([organisationId])
  @@index([entityId])
  @@index([filingDeadline])
  @@index([overallWorkflowStatus])
}

// ── Live objects created from confirmed review items ───────────
// These are only ever created via an explicit human confirmation
// of a draft ReviewItem — never written to directly by extraction.

model Action {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  entityId       String?
  entity         Entity?      @relation(fields: [entityId], references: [id], onDelete: SetNull)

  description             String
  responsibleParty        String?
  accountableParty        String?
  externalOwner           String?
  deadline                DateTime?
  relativeDeadlineTrigger String?
  relativeDeadlineOffset  String?
  evidenceRequired        String?
  conditionText           String?
  status                  String    @default("Open") // Open | Done | Archived

  sourceType              String?
  sourceDocumentReference String?
  sourcePageParagraph     String?
  createdBy               String?
  notes                   String?

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([organisationId])
  @@index([entityId])
}

model Assumption {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  entityId       String?
  entity         Entity?      @relation(fields: [entityId], references: [id], onDelete: SetNull)

  assumptionStatement    String
  factCategory           String?
  relianceImportance     String  @default("Medium") // Low | Medium | High | Critical
  suggestedReviewCadence String?
  linkedCaveat           String?
  conditionText          String?
  status                 String  @default("Active") // Active | Superseded | Archived

  sourceType              String?
  sourceDocumentReference String?
  sourcePageParagraph     String?
  createdBy               String?
  notes                   String?

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([organisationId])
  @@index([entityId])
}

model Tripwire {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  entityId       String?
  entity         Entity?      @relation(fields: [entityId], references: [id], onDelete: SetNull)

  description          String
  triggerEvent         String
  reviewDateOrDeadline DateTime?
  reviewCadence        String?
  disarmCondition      String?
  conditionText        String?
  status               String    @default("Armed") // Armed | Disarmed | Archived

  sourceType              String?
  sourceDocumentReference String?
  sourcePageParagraph     String?
  createdBy               String?
  notes                   String?

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([organisationId])
  @@index([entityId])
}

// ── Document Vault ────────────────────────────────────────────

model Document {
  id             String        @id @default(cuid())
  organisationId String
  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  entityId       String?
  entity         Entity?       @relation(fields: [entityId], references: [id], onDelete: SetNull)
  obligationId   String?
  sourceSystemId String?
  sourceSystem   SourceSystem? @relation("DocumentSourceSystem", fields: [sourceSystemId], references: [id])

  // File metadata
  filename    String
  fileType    String // pdf | docx
  fileSize    Int
  contentHash String
  storageKey  String
  uploadedAt  DateTime @default(now())
  uploadedBy  String?

  // Document classification
  documentType String
  documentDate DateTime?
  periodStart  DateTime?
  periodEnd    DateTime?
  adviserName  String?
  versionLabel String?
  status       String    @default("Uploaded") // Uploaded | Text extracted | Extraction failed | Archived

  // Security & sensitivity
  sensitivityLevel        String  @default("Low") // Low | Medium | High | Highly confidential
  privilegeStatus         String  @default("Unknown") // Not privileged | Potentially privileged | Legally privileged | Unknown
  containsPersonalData    String  @default("Unknown") // Yes | No | Unknown
  containsSpecialCategory String  @default("Unknown")
  containsPayrollData     String  @default("Unknown")
  containsMaData          String  @default("Unknown")
  restrictedAccess        Boolean @default(false)
  accessNotes             String?

  // Source & reliance
  isAuthoritativeSource  String  @default("Unknown") // Yes | No | Unknown
  sourceConfidence       String  @default("Unknown") // High | Medium | Low | Unknown
  supersedesDocumentId   String?
  supersededByDocumentId String?
  relianceStatus         String  @default("Draft") // Draft | Under review | Approved for reliance | Superseded | Do not rely

  // Extraction
  extractionError String?

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  chunks         DocumentChunk[]
  healthFlags    DocumentHealthFlag[]
  extractionRuns ExtractionRun[]
  reviewItems    ReviewItem[]

  @@index([organisationId])
  @@index([entityId])
  @@index([documentType])
  @@index([status])
  @@index([uploadedAt])
}

model DocumentChunk {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex Int
  pageNumber Int?
  text       String

  @@index([documentId])
}

model DocumentHealthFlag {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  marker     String
  context    String?
  chunkIndex Int?
  pageNumber Int?
  createdAt  DateTime @default(now())

  @@index([documentId])
}

// ── AI Extraction ─────────────────────────────────────────────

model ExtractionRun {
  id             String   @id @default(cuid())
  organisationId String
  documentId     String
  document       Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  modelProvider           String @default("openai")
  modelName               String @default("gpt-4o")
  promptVersion           String @default("1")
  extractionSchemaVersion String @default("1")

  startedAt            DateTime  @default(now())
  completedAt          DateTime?
  status               String    @default("Pending") // Pending | Running | Completed | Failed | Partially failed
  errorMessage         String?
  totalChunksProcessed Int       @default(0)
  createdBy            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ReviewItem[]

  @@index([organisationId])
  @@index([documentId])
  @@index([status])
}

model ReviewItem {
  id              String        @id @default(cuid())
  extractionRunId String
  extractionRun   ExtractionRun @relation(fields: [extractionRunId], references: [id], onDelete: Cascade)
  documentId      String
  document        Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  entityId        String?
  entity          Entity?       @relation(fields: [entityId], references: [id], onDelete: SetNull)

  // What was extracted
  itemType        String // obligation | action | assumption | caveat | tripwire | evidence | valuation | rd | capital_allowances | conflict
  structuredJson  Json
  plainSummary    String
  confidenceScore Float  @default(0)

  // Source provenance
  sourceChunkId     String?
  sourcePageSection String?
  sourceTextExcerpt String?

  // Conditions / caveats
  conditionText              String?
  assumptionText             String?
  caveatText                 String?
  isConditional              Boolean @default(false)
  isDraft                    Boolean @default(false)
  requiresHumanTaxReview     Boolean @default(true)
  requiresSourceVerification Boolean @default(false)

  // Suggested fields (for creating live objects)
  suggestedRegime           String?
  suggestedObligationType   String?
  suggestedDeadline         DateTime?
  suggestedOwner            String?
  suggestedEvidenceRequired String?
  suggestedSourceSystemId   String?
  suggestedSourceSystem     SourceSystem? @relation(fields: [suggestedSourceSystemId], references: [id], onDelete: SetNull)

  // Review workflow
  reviewStatus    String    @default("Needs review") // Needs review | In review | Confirmed | Edited and confirmed | Rejected | Duplicate | Not applicable | Needs adviser input | Needs source verification
  reviewedBy      String?
  reviewedAt      DateTime?
  reviewerNotes   String?
  rejectionReason String?

  // Link to live object created from this item
  createdLiveObjectType String?
  createdLiveObjectId   String?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  Organisation   Organisation? @relation(fields: [organisationId], references: [id])
  organisationId String?

  @@index([extractionRunId])
  @@index([documentId])
  @@index([itemType])
  @@index([reviewStatus])
}

// ── Source Systems ────────────────────────────────────────────

model SourceSystem {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  name                   String
  systemType             String
  description            String?
  owner                  String?
  department             String?
  externalProvider       String?
  accessMethod           String?
  refreshFrequency       String?
  containsPersonalData   Boolean @default(false)
  containsPrivilegedData Boolean @default(false)
  status                 String  @default("Active") // Active | Planned | Archived

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  priorityRulesAuth       SourcePriorityRule[]  @relation("AuthoritativeSource")
  priorityRulesSecondary  SourcePriorityRule[]  @relation("SecondarySource")
  priorityRulesTertiary   SourcePriorityRule[]  @relation("TertiarySource")
  conflictsAsA            SourceConflict[]      @relation("ConflictSourceA")
  conflictsAsB            SourceConflict[]      @relation("ConflictSourceB")
  obligationSourceRefs    ObligationSourceRef[]
  documents               Document[]            @relation("DocumentSourceSystem")
  suggestedForReviewItems ReviewItem[]

  @@index([organisationId])
}

model DataCategory {
  id           String   @id @default(cuid())
  name         String   @unique
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  priorityRules        SourcePriorityRule[]
  conflicts            SourceConflict[]
  obligationSourceRefs ObligationSourceRef[]
}

model SourcePriorityRule {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  dataCategoryId String
  dataCategory   DataCategory @relation(fields: [dataCategoryId], references: [id])

  authSourceId      String?
  authSource        SourceSystem? @relation("AuthoritativeSource", fields: [authSourceId], references: [id])
  secondarySourceId String?
  secondarySource   SourceSystem? @relation("SecondarySource", fields: [secondarySourceId], references: [id])
  tertiarySourceId  String?
  tertiarySource    SourceSystem? @relation("TertiarySource", fields: [tertiarySourceId], references: [id])

  conflictHandling String?
  reviewOwner      String?
  reviewFrequency  String?
  notes            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organisationId, dataCategoryId])
  @@index([organisationId])
}

model SourceConflict {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  dataCategoryId String
  dataCategory   DataCategory @relation(fields: [dataCategoryId], references: [id])

  entityId String?
  entity   Entity? @relation(fields: [entityId], references: [id], onDelete: SetNull)

  sourceAId    String
  sourceA      SourceSystem @relation("ConflictSourceA", fields: [sourceAId], references: [id])
  sourceAValue String

  sourceBId    String
  sourceB      SourceSystem @relation("ConflictSourceB", fields: [sourceBId], references: [id])
  sourceBValue String

  severity             String?
  reviewOwner          String?
  requiredConfirmation String?
  status               String    @default("Open")
  resolution           String?
  resolvedValue        String?
  resolutionRationale  String?
  resolvedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId])
  @@index([dataCategoryId])
  @@index([status])
}

model ObligationSourceRef {
  id           String           @id @default(cuid())
  obligationId String           @unique
  obligation   ManualObligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)

  sourceSystemId String?
  sourceSystem   SourceSystem? @relation(fields: [sourceSystemId], references: [id])

  dataCategoryId String?
  dataCategory   DataCategory? @relation(fields: [dataCategoryId], references: [id])

  documentReference String?
  pageOrChunk       String?
  isAuthoritative   Boolean   @default(false)
  overrideReason    String?
  confidence        String? // High | Medium | Low
  lastVerifiedAt    DateTime?
  nextReviewAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditEvent {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  entityId       String?
  entity         Entity?      @relation(fields: [entityId], references: [id], onDelete: SetNull)
  obligationId   String?
  obligation     Obligation?  @relation(fields: [obligationId], references: [id], onDelete: SetNull)
  action         String
  detail         String?
  createdAt      DateTime     @default(now())

  @@index([organisationId])
  @@index([entityId])
  @@index([userId])
  @@index([createdAt])
}
