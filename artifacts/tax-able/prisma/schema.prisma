  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  exceptions    Exception[]
  evidenceItems EvidenceItem[]
  documentLinks DocumentRecordLink[]   @relation("DocumentRecordLinkCaveat")
  reviewLinks   ReviewItemRecordLink[] @relation("ReviewItemRecordLinkCaveat")

  @@index([organisationId])
  @@index([entityId])
  @@index([status])
  @@index([createdById])
}

model Tripwire {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  entityId       String?
  entity         Entity?      @relation(fields: [entityId], references: [id], onDelete: SetNull)

  description          String
  triggerEvent         String
  reviewDateOrDeadline DateTime?
  reviewCadence        String?
  disarmCondition      String?
  conditionText        String?
  status               String    @default("Armed") // Armed | Disarmed | Archived

  sourceType              String?
  sourceDocumentReference String?
  sourcePageParagraph     String?
  createdById             String?
  createdBy               User?   @relation("TripwireCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  notes                   String?

  sourceDocumentId        String?
  sourceDocument          Document?   @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  originatingReviewItemId String?     @unique
