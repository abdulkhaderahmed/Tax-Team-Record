  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  exceptions    Exception[]
  evidenceItems EvidenceItem[]
  documentLinks DocumentRecordLink[]   @relation("DocumentRecordLinkTripwire")
  reviewLinks   ReviewItemRecordLink[] @relation("ReviewItemRecordLinkTripwire")

  @@index([organisationId])
  @@index([entityId])
  @@index([createdById])
}

model Exception {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  entityId       String?
  entity         Entity?      @relation(fields: [entityId], references: [id], onDelete: SetNull)
  obligationId   String?
  obligation     Obligation?  @relation(fields: [obligationId], references: [id], onDelete: SetNull)
  actionId       String?
  action         Action?      @relation(fields: [actionId], references: [id], onDelete: SetNull)
  assumptionId   String?
  assumption     Assumption?  @relation(fields: [assumptionId], references: [id], onDelete: SetNull)
  caveatId       String?
  caveat         Caveat?      @relation(fields: [caveatId], references: [id], onDelete: SetNull)
  tripwireId     String?
  tripwire       Tripwire?    @relation(fields: [tripwireId], references: [id], onDelete: SetNull)
  documentId     String?
  document       Document?    @relation(fields: [documentId], references: [id], onDelete: SetNull)

  title                String
  reason               String
  severity             String    @default("Medium")
  status               String    @default("Open") // Open | In progress | Resolved | Accepted risk | Closed
  blocksFiling         Boolean   @default(true)
  ownerId              String?
  owner                User?     @relation("ExceptionOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  targetResolutionDate DateTime?
  resolutionNote       String?
  resolvedById         String?
  resolvedBy           User?     @relation("ExceptionResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  evidenceItems EvidenceItem[]
  documentLinks DocumentRecordLink[]   @relation("DocumentRecordLinkException")
  reviewLinks   ReviewItemRecordLink[] @relation("ReviewItemRecordLinkException")

  @@index([organisationId, status])
  @@index([obligationId])
  @@index([actionId])
}

model EvidenceItem {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  entityId       String?
  entity         Entity?      @relation(fields: [entityId], references: [id], onDelete: SetNull)
  obligationId   String?
  obligation     Obligation?  @relation(fields: [obligationId], references: [id], onDelete: SetNull)
  actionId       String?
  action         Action?      @relation(fields: [actionId], references: [id], onDelete: SetNull)
  assumptionId   String?
  assumption     Assumption?  @relation(fields: [assumptionId], references: [id], onDelete: SetNull)
  caveatId       String?
  caveat         Caveat?      @relation(fields: [caveatId], references: [id], onDelete: SetNull)
  tripwireId     String?
  tripwire       Tripwire?    @relation(fields: [tripwireId], references: [id], onDelete: SetNull)
  exceptionId    String?
  exception      Exception?   @relation(fields: [exceptionId], references: [id], onDelete: SetNull)
  documentId     String?
  document       Document?    @relation(fields: [documentId], references: [id], onDelete: SetNull)

  title            String
  evidenceType     String?
  description      String?
  status           String    @default("Required") // Required | Requested | Received | Verified | Waived | Rejected
  requiredBy       DateTime?
  ownerId          String?
  owner            User?     @relation("EvidenceOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  verifiedAt       DateTime?
  verifiedById     String?
  verifiedBy       User?     @relation("EvidenceVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verificationNote String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  documentLinks DocumentRecordLink[]   @relation("DocumentRecordLinkEvidence")
  reviewLinks   ReviewItemRecordLink[] @relation("ReviewItemRecordLinkEvidence")

  @@index([organisationId, status])
  @@index([obligationId])
  @@index([actionId])
}

model DataRequest {
  id                      String       @id @default(cuid())
  organisationId          String
  organisation            Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  entityId                String?
  entity                  Entity?      @relation(fields: [entityId], references: [id], onDelete: SetNull)
  obligationId            String?
  obligation              Obligation?  @relation(fields: [obligationId], references: [id], onDelete: SetNull)
  actionId                String?
  action                  Action?      @relation(fields: [actionId], references: [id], onDelete: SetNull)
  requestedFromPartyId    String?
  requestedFromParty      Party?       @relation(fields: [requestedFromPartyId], references: [id], onDelete: SetNull)
  requestedFromDepartment String?
  description             String
  status                  String       @default("Open") // Draft | Open | Received | Validated | Cancelled
  dueDate                 DateTime?
  escalationDate          DateTime?
  createdById             String
  createdBy               User         @relation("DataRequestCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  assignedToId            String?
  assignedTo              User?        @relation("DataRequestAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  responseNote            String?
  completedAt             DateTime?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  reminders               Reminder[]

  @@index([organisationId, status, dueDate])
}

model Reminder {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  dataRequestId  String?
  dataRequest    DataRequest? @relation(fields: [dataRequestId], references: [id], onDelete: SetNull)
  obligationId   String?
  obligation     Obligation?  @relation(fields: [obligationId], references: [id], onDelete: SetNull)
  actionId       String?
  action         Action?      @relation(fields: [actionId], references: [id], onDelete: SetNull)
  ownerId        String?
  owner          User?        @relation("ReminderOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  reminderType   String       @default("Reminder") // Reminder | Escalation
  scheduledFor   DateTime
  status         String       @default("Scheduled") // Scheduled | Due | Acknowledged | Cancelled
  message        String
  acknowledgedAt DateTime?
  createdAt      DateTime     @default(now())

  @@index([organisationId, status, scheduledFor])
}

model Approval {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  entityId       String?
  entity         Entity?      @relation(fields: [entityId], references: [id], onDelete: SetNull)
  obligationId   String?
  obligation     Obligation?  @relation(fields: [obligationId], references: [id], onDelete: SetNull)
  actionId       String?
  action         Action?      @relation(fields: [actionId], references: [id], onDelete: SetNull)
  gate           String // Technical review | Accountable approval | Filing release | Evidence waiver
  status         String       @default("Pending") // Pending | Approved | Rejected | Cancelled | Superseded
  requestedById  String
  requestedBy    User         @relation("ApprovalRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  approverId     String
  approver       User         @relation("ApprovalApprover", fields: [approverId], references: [id], onDelete: Restrict)
  decidedById    String?
  decidedBy      User?        @relation("ApprovalDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  requestedAt    DateTime     @default(now())
  decidedAt      DateTime?
  decisionNote   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organisationId, status])
  @@index([obligationId])
  @@index([actionId])
}

// ── Document Vault ────────────────────────────────────────────

model Document {
  id             String        @id @default(cuid())
  organisationId String
  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  entityId       String?
  entity         Entity?       @relation(fields: [entityId], references: [id], onDelete: SetNull)
  sourceSystemId String?
  sourceSystem   SourceSystem? @relation("DocumentSourceSystem", fields: [sourceSystemId], references: [id])

  // File metadata
  filename     String
  fileType     String // pdf | docx
  fileSize     Int
  contentHash  String
  storageKey   String
  uploadedAt   DateTime @default(now())
  uploadedById String?
  uploadedBy   User?    @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  // Document classification
  documentType String
  documentDate DateTime?
  periodStart  DateTime?
  periodEnd    DateTime?
  adviserName  String?
  versionLabel String?
  status       String    @default("Uploaded") // Uploaded | Text extracted | Extraction failed | Archived

  // Security & sensitivity
  sensitivityLevel        String  @default("Low") // Low | Medium | High | Highly confidential
  privilegeStatus         String  @default("Unknown") // Not privileged | Potentially privileged | Legally privileged | Unknown
  containsPersonalData    String  @default("Unknown") // Yes | No | Unknown
  containsSpecialCategory String  @default("Unknown")
  containsPayrollData     String  @default("Unknown")
  containsMaData          String  @default("Unknown")
  restrictedAccess        Boolean @default(false)
  accessNotes             String?

  // Source & reliance
  isAuthoritativeSource String    @default("Unknown") // Yes | No | Unknown
  sourceConfidence      String    @default("Unknown") // High | Medium | Low | Unknown
  versionNumber         Int       @default(1)
  versionNotes          String?
  supersedesDocumentId  String?   @unique
  supersedes            Document? @relation("DocumentVersions", fields: [supersedesDocumentId], references: [id], onDelete: SetNull)
  supersededBy          Document? @relation("DocumentVersions")
  relianceStatus        String    @default("Draft") // Draft | Under review | Approved for reliance | Superseded | Do not rely
  sourceVerifiedAt      DateTime?
  sourceVerifiedById    String?
  sourceVerifiedBy      User?     @relation("DocumentSourceVerifiedBy", fields: [sourceVerifiedById], references: [id], onDelete: SetNull)

  // Extraction
  extractionError String?

  archivedAt     DateTime?
  deletedAt      DateTime?
  deletedById    String?
  deletedBy      User?     @relation("DocumentDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deletionReason String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  chunks            DocumentChunk[]
  healthFlags       DocumentHealthFlag[]
  extractionRuns    ExtractionRun[]
  reviewItems       ReviewItem[]
  accessGrants      DocumentAccess[]
  obligations       Obligation[]
  actions           Action[]
  assumptions       Assumption[]
  caveats           Caveat[]
  tripwires         Tripwire[]
  exceptions        Exception[]
  evidenceItems     EvidenceItem[]
  entityRelations   EntityRelation[]
  accountingPeriods AccountingPeriod[]
  recordLinks       DocumentRecordLink[]

  @@index([organisationId])
  @@index([entityId])
  @@index([documentType])
  @@index([status])
  @@index([uploadedAt])
}

model DocumentAccess {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  documentId     String
  document       Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("DocumentAccessUser", fields: [userId], references: [id], onDelete: Cascade)
  permission     String       @default("view") // view | edit | review | manage
  grantedAt      DateTime     @default(now())
  grantedById    String?
  grantedBy      User?        @relation("DocumentAccessGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  expiresAt      DateTime?
  reason         String?

  @@unique([documentId, userId])
  @@index([organisationId])
  @@index([userId])
}

model DocumentChunk {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex Int
  pageNumber Int?
  text       String

  @@index([documentId])
}

model DocumentHealthFlag {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  marker     String
  context    String?
  chunkIndex Int?
  pageNumber Int?
  createdAt  DateTime @default(now())

  @@index([documentId])
}

// ── AI Extraction ─────────────────────────────────────────────

model ExtractionRun {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  documentId     String
  document       Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)

  modelProvider           String @default("openai")
  modelName               String @default("gpt-4o")
  promptVersion           String @default("1")
  extractionSchemaVersion String @default("1")

  startedAt            DateTime  @default(now())
  completedAt          DateTime?
  status               String    @default("Pending") // Pending | Running | Completed | Failed | Partially failed
  errorMessage         String?
  totalChunksProcessed Int       @default(0)
  createdById          String?
  createdBy            User?     @relation("ExtractionRunCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  attemptCount         Int       @default(0)
  lockedAt             DateTime?
  heartbeatAt          DateTime?
  nextAttemptAt        DateTime  @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ReviewItem[]

  @@index([organisationId])
  @@index([documentId])
  @@index([status])
}

model ReviewItem {
  id              String        @id @default(cuid())
  extractionRunId String
  extractionRun   ExtractionRun @relation(fields: [extractionRunId], references: [id], onDelete: Cascade)
  documentId      String
  document        Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  entityId        String?
  entity          Entity?       @relation(fields: [entityId], references: [id], onDelete: SetNull)

  // What was extracted
  itemType        String // obligation | action | assumption | caveat | tripwire | evidence | valuation | rd | capital_allowances | conflict
  structuredJson  Json
  plainSummary    String
  confidenceScore Float  @default(0)

  // Source provenance
  sourceChunkId     String?
  sourcePageSection String?
  sourceTextExcerpt String?

  // Conditions / caveats
  conditionText              String?
  assumptionText             String?
  caveatText                 String?
  isConditional              Boolean @default(false)
  isDraft                    Boolean @default(false)
  requiresHumanTaxReview     Boolean @default(true)
  requiresSourceVerification Boolean @default(false)

  // Suggested fields (for creating live objects)
  suggestedRegime           String?
  suggestedObligationType   String?
  suggestedDeadline         DateTime?
  suggestedOwner            String?
  suggestedEvidenceRequired String?
  suggestedSourceSystemId   String?
  suggestedSourceSystem     SourceSystem? @relation(fields: [suggestedSourceSystemId], references: [id], onDelete: SetNull)

  // Review workflow
  reviewStatus    String    @default("Needs review") // Needs review | In review | Confirmed | Edited and confirmed | Rejected | Duplicate | Not applicable | Needs adviser input | Needs source verification
  reviewedById    String?
  reviewedBy      User?     @relation("ReviewItemReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  reviewerNotes   String?
  rejectionReason String?

  // Link to live object created from this item
  createdLiveObjectType String?
  createdLiveObjectId   String?
  createdObligation     Obligation?            @relation("ReviewItemCreatedObligation")
  createdAction         Action?                @relation("ReviewItemCreatedAction")
  createdAssumption     Assumption?            @relation("ReviewItemCreatedAssumption")
  createdCaveat         Caveat?                @relation("ReviewItemCreatedCaveat")
  createdTripwire       Tripwire?              @relation("ReviewItemCreatedTripwire")
  recordLinks           ReviewItemRecordLink[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  organisationId String

  @@index([extractionRunId])
  @@index([documentId])
  @@index([itemType])
  @@index([reviewStatus])
}

/// Many-to-many provenance between a document and the live control records it
/// supports. A database check constraint enforces exactly one target column.
model DocumentRecordLink {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  documentId     String
  document       Document     @relation(fields: [documentId], references: [id], onDelete: Restrict)
  linkType       String       @default("Source") // Source | Evidence | Corroborates | Contradicts
  pageReference  String?
  sourceExcerpt  String?
  createdById    String?
  createdBy      User?        @relation("DocumentRecordLinkCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  obligationId String?
  obligation   Obligation?   @relation("DocumentRecordLinkObligation", fields: [obligationId], references: [id], onDelete: Restrict)
  actionId     String?
  action       Action?       @relation("DocumentRecordLinkAction", fields: [actionId], references: [id], onDelete: Restrict)
  assumptionId String?
  assumption   Assumption?   @relation("DocumentRecordLinkAssumption", fields: [assumptionId], references: [id], onDelete: Restrict)
  caveatId     String?
  caveat       Caveat?       @relation("DocumentRecordLinkCaveat", fields: [caveatId], references: [id], onDelete: Restrict)
  tripwireId   String?
  tripwire     Tripwire?     @relation("DocumentRecordLinkTripwire", fields: [tripwireId], references: [id], onDelete: Restrict)
  exceptionId  String?
  exception    Exception?    @relation("DocumentRecordLinkException", fields: [exceptionId], references: [id], onDelete: Restrict)
  evidenceId   String?
  evidence     EvidenceItem? @relation("DocumentRecordLinkEvidence", fields: [evidenceId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([documentId, obligationId, linkType])
  @@unique([documentId, actionId, linkType])
  @@unique([documentId, assumptionId, linkType])
  @@unique([documentId, caveatId, linkType])
  @@unique([documentId, tripwireId, linkType])
  @@unique([documentId, exceptionId, linkType])
  @@unique([documentId, evidenceId, linkType])
  @@index([organisationId])
  @@index([createdById])
}

/// Durable lineage for every extracted review item linked to a live record.
/// Creation provenance remains on the live record; this table also supports
/// later links, duplicates and multiple source items per record.
model ReviewItemRecordLink {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  reviewItemId   String
  reviewItem     ReviewItem   @relation(fields: [reviewItemId], references: [id], onDelete: Restrict)
  relationType   String       @default("Linked") // Created | Linked | Duplicate
  createdById    String?
  createdBy      User?        @relation("ReviewItemRecordLinkCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  obligationId String?
  obligation   Obligation?   @relation("ReviewItemRecordLinkObligation", fields: [obligationId], references: [id], onDelete: Restrict)
  actionId     String?
  action       Action?       @relation("ReviewItemRecordLinkAction", fields: [actionId], references: [id], onDelete: Restrict)
  assumptionId String?
  assumption   Assumption?   @relation("ReviewItemRecordLinkAssumption", fields: [assumptionId], references: [id], onDelete: Restrict)
  caveatId     String?
  caveat       Caveat?       @relation("ReviewItemRecordLinkCaveat", fields: [caveatId], references: [id], onDelete: Restrict)
  tripwireId   String?
  tripwire     Tripwire?     @relation("ReviewItemRecordLinkTripwire", fields: [tripwireId], references: [id], onDelete: Restrict)
  exceptionId  String?
  exception    Exception?    @relation("ReviewItemRecordLinkException", fields: [exceptionId], references: [id], onDelete: Restrict)
  evidenceId   String?
  evidence     EvidenceItem? @relation("ReviewItemRecordLinkEvidence", fields: [evidenceId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([reviewItemId, obligationId, relationType])
  @@unique([reviewItemId, actionId, relationType])
  @@unique([reviewItemId, assumptionId, relationType])
  @@unique([reviewItemId, caveatId, relationType])
  @@unique([reviewItemId, tripwireId, relationType])
  @@unique([reviewItemId, exceptionId, relationType])
  @@unique([reviewItemId, evidenceId, relationType])
  @@index([organisationId])
  @@index([createdById])
}

// ── Source Systems ────────────────────────────────────────────

model SourceSystem {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  name                   String
  systemType             String
  description            String?
  owner                  String?
  department             String?
  externalProvider       String?
  accessMethod           String?
  refreshFrequency       String?
  containsPersonalData   Boolean @default(false)
  containsPrivilegedData Boolean @default(false)
  status                 String  @default("Active") // Active | Planned | Archived

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  priorityRulesAuth       SourcePriorityRule[]  @relation("AuthoritativeSource")
  priorityRulesSecondary  SourcePriorityRule[]  @relation("SecondarySource")
  priorityRulesTertiary   SourcePriorityRule[]  @relation("TertiarySource")
  conflictsAsA            SourceConflict[]      @relation("ConflictSourceA")
  conflictsAsB            SourceConflict[]      @relation("ConflictSourceB")
  obligationSourceRefs    ObligationSourceRef[]
  documents               Document[]            @relation("DocumentSourceSystem")
  suggestedForReviewItems ReviewItem[]
  taxRegistrations        TaxRegistration[]

  @@index([organisationId])
}

model DataCategory {
  id           String   @id @default(cuid())
  name         String   @unique
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  priorityRules        SourcePriorityRule[]
  conflicts            SourceConflict[]
  obligationSourceRefs ObligationSourceRef[]
}

model SourcePriorityRule {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  dataCategoryId String
  dataCategory   DataCategory @relation(fields: [dataCategoryId], references: [id])

  authSourceId      String?
  authSource        SourceSystem? @relation("AuthoritativeSource", fields: [authSourceId], references: [id])
  secondarySourceId String?
  secondarySource   SourceSystem? @relation("SecondarySource", fields: [secondarySourceId], references: [id])
  tertiarySourceId  String?
  tertiarySource    SourceSystem? @relation("TertiarySource", fields: [tertiarySourceId], references: [id])

  conflictHandling String?
  reviewOwnerId    String?
  reviewOwner      User?   @relation("PriorityRuleReviewOwner", fields: [reviewOwnerId], references: [id], onDelete: SetNull)
  reviewFrequency  String?
  notes            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organisationId, dataCategoryId])
  @@index([organisationId])
  @@index([reviewOwnerId])
}

model SourceConflict {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  dataCategoryId String
  dataCategory   DataCategory @relation(fields: [dataCategoryId], references: [id])

  entityId String?
  entity   Entity? @relation(fields: [entityId], references: [id], onDelete: SetNull)

  sourceAId    String
  sourceA      SourceSystem @relation("ConflictSourceA", fields: [sourceAId], references: [id])
  sourceAValue String

  sourceBId    String
  sourceB      SourceSystem @relation("ConflictSourceB", fields: [sourceBId], references: [id])
  sourceBValue String

  severity             String?
  reviewOwnerId        String?
  reviewOwner          User?     @relation("SourceConflictReviewOwner", fields: [reviewOwnerId], references: [id], onDelete: SetNull)
  requiredConfirmation String?
  status               String    @default("Open")
  resolution           String?
  resolvedValue        String?
  resolutionRationale  String?
  resolvedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisationId])
  @@index([dataCategoryId])
  @@index([status])
  @@index([reviewOwnerId])
}

model ObligationSourceRef {
  id           String     @id @default(cuid())
  obligationId String     @unique
  obligation   Obligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)

  sourceSystemId String?
  sourceSystem   SourceSystem? @relation(fields: [sourceSystemId], references: [id])

  dataCategoryId String?
  dataCategory   DataCategory? @relation(fields: [dataCategoryId], references: [id])

  documentReference String?
  pageOrChunk       String?
  isAuthoritative   Boolean   @default(false)
  overrideReason    String?
  confidence        String? // High | Medium | Low
  lastVerifiedAt    DateTime?
  nextReviewAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditEvent {
  id                 String       @id @default(cuid())
  organisationId     String
  organisation       Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  userId             String?
  user               User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  entityId           String?
  entity             Entity?      @relation(fields: [entityId], references: [id], onDelete: SetNull)
  obligationId       String?
  obligation         Obligation?  @relation(fields: [obligationId], references: [id], onDelete: SetNull)
  actionId           String?
  actionRecord       Action?      @relation(fields: [actionId], references: [id], onDelete: SetNull)
  action             String
  detail             String?
  objectType         String?
  objectId           String?
  beforeJson         Json?
  afterJson          Json?
  reason             String?
  correlationId      String?
  actorNameSnapshot  String?
  actorEmailSnapshot String?
  createdAt          DateTime     @default(now())

  @@index([organisationId])
  @@index([entityId])
  @@index([userId])
  @@index([createdAt])
  @@index([objectType, objectId])
  @@index([actionId])
}
