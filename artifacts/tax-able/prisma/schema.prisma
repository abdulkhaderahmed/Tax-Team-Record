  entity         Entity?      @relation(fields: [entityId], references: [id], onDelete: SetNull)

  assumptionStatement    String
  factCategory           String?
  relianceImportance     String  @default("Medium") // Low | Medium | High | Critical
  suggestedReviewCadence String?
  linkedCaveat           String?
