  objectType  String // Obligation | Action
  objectId    String
  statusField String // e.g. dataCompletenessStatus, overallWorkflowStatus, responsibleOwner, evidenceRequired...
  oldValue    String?
  newValue    String?
  changedById String?
  changedBy   User?    @relation("StatusHistoryChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  changedAt   DateTime @default(now())
  reason      String?

  @@index([objectType, objectId])
  @@index([changedAt])
  @@index([changedById])
}

model Assumption {
