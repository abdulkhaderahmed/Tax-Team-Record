generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organisation {
  id         String   @id @default(cuid())
  name       String
  clerkOrgId String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users               User[]
  entities            Entity[]
  auditEvents         AuditEvent[]
  obligations         Obligation[]
  sourceSystems       SourceSystem[]
  sourcePriorityRules SourcePriorityRule[]
  sourceConflicts     SourceConflict[]
  documents           Document[]
  reviewItems         ReviewItem[]
  actions             Action[]
  assumptions         Assumption[]
  caveats             Caveat[]
  tripwires           Tripwire[]
  parties             Party[]
  entityGroups        EntityGroup[]
  entityRelations     EntityRelation[]
  taxRegistrations    TaxRegistration[]
  taxRules            TaxRule[]
  ruleImpactReviews   RuleImpactReview[]
  exceptions          Exception[]
  evidenceItems       EvidenceItem[]
  dataRequests        DataRequest[]
  reminders           Reminder[]
  approvals           Approval[]
  documentAccess      DocumentAccess[]
  accountingPeriods   AccountingPeriod[]
  regimeAssessments   RegimeAssessment[]
  documentRecordLinks DocumentRecordLink[]
  reviewRecordLinks   ReviewItemRecordLink[]
  extractionRuns      ExtractionRun[]
  matters             Matter[]
}

model User {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  email          String       @unique
  clerkUserId    String?      @unique
  role           String       @default("member")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  auditEvents                AuditEvent[]
  rulesCreated               TaxRuleVersion[]       @relation("RuleVersionCreatedBy")
  rulesReviewed              TaxRuleVersion[]       @relation("RuleVersionReviewedBy")
  impactReviews              RuleImpactReview[]
  documentAccess             DocumentAccess[]       @relation("DocumentAccessUser")
  documentAccessGranted      DocumentAccess[]       @relation("DocumentAccessGrantedBy")
  documentsSourceVerified    Document[]             @relation("DocumentSourceVerifiedBy")
  obligationsDeleted         Obligation[]           @relation("ObligationDeletedBy")
  actionsDeleted             Action[]               @relation("ActionDeletedBy")
  exceptionsOwned            Exception[]            @relation("ExceptionOwner")
  exceptionsResolved         Exception[]            @relation("ExceptionResolvedBy")
  evidenceOwned              EvidenceItem[]         @relation("EvidenceOwner")
  evidenceVerified           EvidenceItem[]         @relation("EvidenceVerifiedBy")
  dataRequestsCreated        DataRequest[]          @relation("DataRequestCreatedBy")
  dataRequestsAssigned       DataRequest[]          @relation("DataRequestAssignedTo")
  remindersOwned             Reminder[]             @relation("ReminderOwner")
  approvalsRequested         Approval[]             @relation("ApprovalRequestedBy")
  approvalsAssigned          Approval[]             @relation("ApprovalApprover")
  approvalsDecided           Approval[]             @relation("ApprovalDecidedBy")
  taxRegistrationsVerified   TaxRegistration[]      @relation("TaxRegistrationVerifiedBy")
  mattersCreated             Matter[]               @relation("MatterCreatedBy")
  accountingPeriodsVerified  AccountingPeriod[]     @relation("AccountingPeriodVerifiedBy")
  regimeAssessmentsConfirmed RegimeAssessment[]     @relation("RegimeAssessmentConfirmedBy")
  obligationsCreated         Obligation[]           @relation("ObligationCreatedBy")
  obligationsUpdated         Obligation[]           @relation("ObligationUpdatedBy")
  actionsCreated             Action[]               @relation("ActionCreatedBy")
  actionsUpdated             Action[]               @relation("ActionUpdatedBy")
  documentsUploaded          Document[]             @relation("DocumentUploadedBy")
  extractionRunsCreated      ExtractionRun[]        @relation("ExtractionRunCreatedBy")
  reviewItemsReviewed        ReviewItem[]           @relation("ReviewItemReviewedBy")
  sourcePriorityRulesOwned   SourcePriorityRule[]   @relation("PriorityRuleReviewOwner")
  sourceConflictsOwned       SourceConflict[]       @relation("SourceConflictReviewOwner")
  assumptionsCreated         Assumption[]           @relation("AssumptionCreatedBy")
  caveatsCreated             Caveat[]               @relation("CaveatCreatedBy")
  tripwiresCreated           Tripwire[]             @relation("TripwireCreatedBy")
  statusChanges              StatusHistory[]        @relation("StatusHistoryChangedBy")
  documentRecordLinksCreated DocumentRecordLink[]   @relation("DocumentRecordLinkCreatedBy")
  reviewRecordLinksCreated   ReviewItemRecordLink[] @relation("ReviewItemRecordLinkCreatedBy")
  entitiesDeleted            Entity[]               @relation("EntityDeletedBy")
  documentsDeleted           Document[]             @relation("DocumentDeletedBy")
}

model Entity {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  // Identification
  legalName            String
  companiesHouseNumber String?
  jurisdiction         String  @default("England & Wales")
  entityType           String?
  ukTaxResident        Boolean @default(true)

  // Corporation Tax
  corporationTaxUtr         String?
  accountingPeriodStart     DateTime?
  accountingPeriodEnd       DateTime?
  companiesHouseAccountsDue DateTime?
  ctReturnRequired          Boolean   @default(true)
  ctPaymentMethod           String?
  isLargeCompany            Boolean   @default(false)
  isVeryLargeCompany        Boolean   @default(false)
  taxableProfitsBand        String?

  // VAT
  vatRegistered         Boolean @default(false)
  vatRegistrationNumber String?
  vatQuarterEndMonth    Int?

  // Payroll & Employment
  payeRegistered                  Boolean @default(false)
  hasErs                          Boolean @default(false)
  hasEmi                          Boolean @default(false)
  p11dRequired                    Boolean @default(false)
  psaRequired                     Boolean @default(false)
  benefitsReportingMethod         String  @default("P11D") // P11D | Voluntary payroll | Mandatory payroll | Mixed
  hasLoansOrAccommodationBenefits Boolean @default(false)
  psaAgreementStatus              String  @default("Not in place") // Not in place | Enduring | Amendment needed
  psaPaymentMethod                String  @default("Electronic")

  // R&D
  rdClaimExpected      Boolean @default(false)
  rdNotificationNeeded Boolean @default(false)
  rdAifNeeded          Boolean @default(false)

  // Capital Allowances
  capitalAllowancesActivity Boolean @default(false)
  fullExpensingRelevant     Boolean @default(false)
  aiaRelevant               Boolean @default(false)
  specialRatePoolRelevant   Boolean @default(false)

  // Group & International
  groupReliefRelevant         Boolean @default(false)
  lossesBroughtForward        Boolean @default(false)
  transferPricingRelevant     Boolean @default(false)
  hasPillar2                  Boolean @default(false)
  pillar2FirstReportingPeriod Boolean @default(true)

  // Governance
  saoInScope                  Boolean @default(false)
  ccoInScope                  Boolean @default(false)
  publishedTaxStrategyInScope Boolean @default(false)

  // Ownership
  primaryTaxOwner String?
  financeOwner    String?
  payrollOwner    String?
  externalAdviser String?

  // Group and associated-company structure
  groupId                   String?
  group                     EntityGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  parentEntityId            String?
  parentEntity              Entity?      @relation("EntityHierarchy", fields: [parentEntityId], references: [id], onDelete: SetNull)
  childEntities             Entity[]     @relation("EntityHierarchy")
  qipAssociatedCompanyCount Int          @default(1)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  archivedAt     DateTime?
  deletedAt      DateTime?
  deletedById    String?
  deletedBy      User?     @relation("EntityDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deletionReason String?

  obligations       Obligation[]
  auditEvents       AuditEvent[]
  sourceConflicts   SourceConflict[]
  documents         Document[]
  reviewItems       ReviewItem[]
  actions           Action[]
  assumptions       Assumption[]
  caveats           Caveat[]
  tripwires         Tripwire[]
  outgoingRelations EntityRelation[]   @relation("RelationFromEntity")
  incomingRelations EntityRelation[]   @relation("RelationToEntity")
  taxRegistrations  TaxRegistration[]
  ruleImpactReviews RuleImpactReview[]
  exceptions        Exception[]
  evidenceItems     EvidenceItem[]
  dataRequests      DataRequest[]
  approvals         Approval[]
  accountingPeriods AccountingPeriod[]
  regimeAssessments RegimeAssessment[]
  matters           Matter[]
}

model EntityGroup {
  id                     String             @id @default(cuid())
  organisationId         String
  organisation           Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name                   String
  description            String?
  associatedCompanyCount Int                @default(1)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  entities               Entity[]
  regimeAssessments      RegimeAssessment[]

  @@unique([organisationId, name])
  @@index([organisationId])
}

model AccountingPeriod {
  id                   String       @id @default(cuid())
  organisationId       String
  organisation         Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  entityId             String
  entity               Entity       @relation(fields: [entityId], references: [id], onDelete: Cascade)
  periodOfAccountStart DateTime
  periodOfAccountEnd   DateTime
  ctPeriodStart        DateTime
  ctPeriodEnd          DateTime
  periodType           String       @default("Corporation Tax")
  status               String       @default("Confirmed") // Draft | Confirmed | Superseded
  sourceDocumentId     String?
  sourceDocument       Document?    @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  verifiedAt           DateTime?
  verifiedById         String?
  verifiedBy           User?        @relation("AccountingPeriodVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@unique([entityId, ctPeriodStart, ctPeriodEnd])
  @@index([organisationId])
  @@index([entityId, status])
}

model RegimeAssessment {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  entityId       String?
  entity         Entity?      @relation(fields: [entityId], references: [id], onDelete: Cascade)
  groupId        String?
  group          EntityGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  regime         String
  periodStart    DateTime
  periodEnd      DateTime
  outcome        String // In scope | Out of scope | Uncertain | Insufficient data
  inputsJson     Json
  rationale      String?
  confirmedAt    DateTime?
  confirmedById  String?
  confirmedBy    User?        @relation("RegimeAssessmentConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([entityId, regime])
  @@index([groupId, regime])
}

model EntityRelation {
  id               String       @id @default(cuid())
  organisationId   String
  organisation     Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  fromEntityId     String
  fromEntity       Entity       @relation("RelationFromEntity", fields: [fromEntityId], references: [id], onDelete: Cascade)
  toEntityId       String
  toEntity         Entity       @relation("RelationToEntity", fields: [toEntityId], references: [id], onDelete: Cascade)
  relationType     String // Parent | Subsidiary | Associated company | VAT group | CT group | Other
  ownershipPct     Decimal?     @db.Decimal(7, 4)
  effectiveFrom    DateTime?
  effectiveTo      DateTime?
  sourceDocumentId String?
  sourceDocument   Document?    @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([organisationId, fromEntityId, toEntityId, relationType, effectiveFrom])
  @@index([organisationId])
}

model TaxRegistration {
  id                 String        @id @default(cuid())
  organisationId     String
  organisation       Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  entityId           String
  entity             Entity        @relation(fields: [entityId], references: [id], onDelete: Cascade)
  registrationType   String // Corporation Tax | VAT | PAYE | ERS | Pillar 2 | FATCA | CRS | Other
  reference          String?
  jurisdiction       String        @default("United Kingdom")
  status             String        @default("Active")
  effectiveFrom      DateTime?
  effectiveTo        DateTime?
  sourceSystemId     String?
  sourceSystem       SourceSystem? @relation(fields: [sourceSystemId], references: [id], onDelete: SetNull)
  sourceVerifiedAt   DateTime?
  sourceVerifiedById String?
  sourceVerifiedBy   User?         @relation("TaxRegistrationVerifiedBy", fields: [sourceVerifiedById], references: [id], onDelete: SetNull)
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([entityId, registrationType, jurisdiction])
  @@index([organisationId])
  @@index([entityId])
}

model TaxRule {
  id             String           @id @default(cuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  ruleKey        String
  regime         String
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  versions       TaxRuleVersion[]

  @@unique([organisationId, ruleKey])
  @@index([organisationId])
}

/// Read-only archive of the retired pre-controlled-content rule records. These
/// rows are never evaluated by the generator; they exist solely for migration
/// and audit traceability.
model LegacyRuleSnapshot {
  id              String   @id
  ruleKey         String   @unique
  name            String
  description     String
  appliesTo       String
  sourceCreatedAt DateTime
  sourceUpdatedAt DateTime
  retiredAt       DateTime @default(now())
}

model TaxRuleVersion {
  id                     String          @id @default(cuid())
  ruleId                 String
  rule                   TaxRule         @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  version                Int
  name                   String
  description            String
  obligationType         String
  statutoryBasis         String
  statutoryUrl           String
  authorityLevel         String // Legislation | Statutory notice | HMRC manual | GOV.UK guidance | Draft guidance
  legalStatus            String // Enacted | In force | Administrative | Interim draft
  triggerDescription     String
  triggerConfig          Json
  calculationKey         String
  calculationDescription String
  recurrence             String
  effectiveFrom          DateTime
  effectiveTo            DateTime?
  status                 String          @default("Draft") // Draft | Approved | Superseded | Withdrawn
  humanReviewRequired    Boolean         @default(false)
  changeRationale        String
  sourceLastCheckedAt    DateTime
  logicHash              String?
  engineVersion          String // Immutable deterministic engine identifier reviewed with this content version
  createdById            String
  createdBy              User            @relation("RuleVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedById           String?
  reviewedBy             User?           @relation("RuleVersionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt             DateTime?
  supersedesVersionId    String?         @unique
  supersedesVersion      TaxRuleVersion? @relation("RuleVersionSupersession", fields: [supersedesVersionId], references: [id], onDelete: SetNull)
  supersededByVersion    TaxRuleVersion? @relation("RuleVersionSupersession")
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  obligations   Obligation[]
  impactReviews RuleImpactReview[]
  citations     RuleCitation[]

  @@unique([ruleId, version])
  @@index([ruleId, status, effectiveFrom])
  @@index([engineVersion])
}

model RuleCitation {
  id             String         @id @default(cuid())
  ruleVersionId  String
  ruleVersion    TaxRuleVersion @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)
  title          String
  url            String
  authorityLevel String
  locator        String?
  checkedAt      DateTime
  createdAt      DateTime       @default(now())

  @@unique([ruleVersionId, url])
  @@index([ruleVersionId])
}

model RuleImpactReview {
  id             String         @id @default(cuid())
  organisationId String
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  ruleVersionId  String
  ruleVersion    TaxRuleVersion @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)
  entityId       String
  entity         Entity         @relation(fields: [entityId], references: [id], onDelete: Cascade)
  status         String         @default("Needs review") // Needs review | Confirmed applicable | Not applicable | Remediated
  impactSummary  String
  dueDate        DateTime?
  reviewedById   String?
  reviewedBy     User?          @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([ruleVersionId, entityId])
  @@index([organisationId, status])
}

model Obligation {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  entityId       String?
  entity         Entity?      @relation(fields: [entityId], references: [id], onDelete: SetNull)

  // Core
  regime             String
  obligationType     String
  description        String
  statutoryBasis     String?
  filingDeadline     DateTime?
  paymentDeadline    DateTime?
  internalTargetDate DateTime?
  recurrence         String?
  periodStart        DateTime?
  periodEnd          DateTime?
  source             String?

  // Ownership (RACI) — free-text quick fields; richer structured records
  // for the same roles are optionally tracked via raciAssignments below.
  responsibleOwner         String?
  accountableOwner         String?
  consultedParty           String?
  informedParty            String?
  externalAdviser          String?
  externalOperationalOwner String?

  // Requirement flags — not every obligation needs every status dimension
  dataCollectionRequired      Boolean @default(true)
  dataValidationRequired      Boolean @default(true)
  technicalReviewRequired     Boolean @default(true)
  accountableApprovalRequired Boolean @default(true)
  filingSubmissionRequired    Boolean @default(true)
  paymentRequired             Boolean @default(false)

  // Status (9 separate dimensions — see src/lib/ownership-control.ts)
  dataCompletenessStatus  String  @default("Not started")
  dataValidationStatus    String  @default("Not started")
  technicalReviewStatus   String  @default("Not started")
  approvalStatus          String  @default("Not started")
  workflowProgressStatus  String  @default("Not started")
  evidenceStatus          String  @default("Not started")
  filingSubmissionStatus  String  @default("Not started")
  paymentStatus           String  @default("Not started")
  overallWorkflowStatus   String  @default("Not started")
  overallStatusIsOverride Boolean @default(false)

  // Evidence
  evidenceRequired    Boolean @default(false)
  evidenceDescription String?
  evidenceFileLink    String?
  evidenceOwner       String?

  // Risk & control
  riskLevel                    String?
  consequenceOfMissingDeadline String?
  openIssueBlocker             String?
  notes                        String?
  exceptionRequired            Boolean @default(false)

  // Source & audit
  sourceType              String?
  sourceDocumentReference String?
  sourcePageParagraph     String?
  createdById             String?
  createdBy               User?   @relation("ObligationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lastUpdatedById         String?
  lastUpdatedBy           User?   @relation("ObligationUpdatedBy", fields: [lastUpdatedById], references: [id], onDelete: SetNull)

  // Rules-pack / draft generation
  ruleId            String?
  calculationBasis  String?
  humanExplanation  String?
  draftReviewStatus String? // pending | activated | rejected | not_applicable
  draftNote         String?
  generationBatchId String?
  occurrenceKey     String?

  // Controlled rule provenance
  ruleVersionId     String?
  ruleVersion       TaxRuleVersion? @relation(fields: [ruleVersionId], references: [id], onDelete: SetNull)
  ruleVersionNumber Int?
  ruleKey           String?
  whyApplies        String?

  // True source links
  sourceDocumentId        String?
  sourceDocument          Document?   @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  originatingReviewItemId String?     @unique
  originatingReviewItem   ReviewItem? @relation("ReviewItemCreatedObligation", fields: [originatingReviewItemId], references: [id], onDelete: SetNull)

  archivedAt     DateTime?
  deletedAt      DateTime?
  deletedById    String?
  deletedBy      User?     @relation("ObligationDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deletionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sourceRef       ObligationSourceRef?
  raciAssignments RaciAssignment[]
  auditEvents     AuditEvent[]
  exceptions      Exception[]
  evidenceItems   EvidenceItem[]
  dataRequests    DataRequest[]
  approvals       Approval[]
  reminders       Reminder[]
  documentLinks   DocumentRecordLink[]   @relation("DocumentRecordLinkObligation")
  reviewLinks     ReviewItemRecordLink[] @relation("ReviewItemRecordLinkObligation")

  @@unique([organisationId, entityId, occurrenceKey])
  @@index([organisationId])
  @@index([entityId])
  @@index([filingDeadline])
  @@index([overallWorkflowStatus])
  @@map("ManualObligation")
}

// ── Live objects created from confirmed review items ───────────
// These are only ever created via an explicit human confirmation
// of a draft ReviewItem — never written to directly by extraction.

/// A unit of tax work that needs resolving: a transaction, an enquiry, an
/// adviser report to implement. Deliberately thin — it links existing records
/// rather than duplicating them (see DECISIONS.md D-025).
model Matter {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  entityId       String?
  entity         Entity?      @relation(fields: [entityId], references: [id], onDelete: SetNull)

  reference   String
  title       String
  matterType  String // Transaction | Advice implementation | Enquiry | Reorganisation | Incentives & reward | Compliance | Other
  summary     String?

  /// The question this matter exists to answer. Required — a matter without a
  /// decision to reach is a folder, not a matter.
  decisionQuestion String

  status   String @default("Open") // Open | Blocked | Awaiting approval | Resolved | Not proceeded
  priority String @default("Normal") // Low | Normal | High | Critical

  taxAreas String? // comma-separated, e.g. "Corporation tax, VAT, ERS"

  taxOwner        String?
  businessSponsor String?
  externalAdviser String?

  targetDecisionDate DateTime?
  resolvedAt         DateTime?
  resolutionNote     String?

  createdByUserId String?
  createdBy       User?   @relation("MatterCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  archivedAt     DateTime?
  archivedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organisationId, reference])
  @@index([organisationId, status])
  @@index([entityId])
}

model Action {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  entityId       String?
  entity         Entity?      @relation(fields: [entityId], references: [id], onDelete: SetNull)

  description             String
  deadline                DateTime?
  relativeDeadlineTrigger String?
  relativeDeadlineOffset  String?
  evidenceDescription     String?
  conditionText           String?

  // Ownership (RACI) — free-text quick fields; richer structured records
  // for the same roles are optionally tracked via raciAssignments below.
  responsibleParty         String?
  accountableParty         String?
  consultedParty           String?
  informedParty            String?
  externalAdviser          String?
  externalOperationalOwner String?

  // Requirement flags — not every action needs every status dimension
  dataCollectionRequired      Boolean @default(false)
  dataValidationRequired      Boolean @default(false)
  technicalReviewRequired     Boolean @default(false)
  accountableApprovalRequired Boolean @default(true)
  evidenceRequired            Boolean @default(false)
  filingSubmissionRequired    Boolean @default(false)
  paymentRequired             Boolean @default(false)

  // Status (9 separate dimensions — see src/lib/ownership-control.ts)
  dataCompletenessStatus  String  @default("Not started")
  dataValidationStatus    String  @default("Not started")
  technicalReviewStatus   String  @default("Not started")
  approvalStatus          String  @default("Not started")
  workflowProgressStatus  String  @default("Not started")
  evidenceStatus          String  @default("Not started")
  filingSubmissionStatus  String  @default("Not started")
  paymentStatus           String  @default("Not started")
  overallStatus           String  @default("Not started")
  overallStatusIsOverride Boolean @default(false)

  // Risk & control
  riskLevel         String?
  openIssueBlocker  String?
  exceptionRequired Boolean @default(false)

  sourceType              String?
  sourceDocumentReference String?
  sourcePageParagraph     String?
  createdById             String?
  createdBy               User?   @relation("ActionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lastUpdatedById         String?
  lastUpdatedBy           User?   @relation("ActionUpdatedBy", fields: [lastUpdatedById], references: [id], onDelete: SetNull)
  notes                   String?

  sourceDocumentId        String?
  sourceDocument          Document?   @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  originatingReviewItemId String?     @unique
  originatingReviewItem   ReviewItem? @relation("ReviewItemCreatedAction", fields: [originatingReviewItemId], references: [id], onDelete: SetNull)

  archivedAt     DateTime?
  deletedAt      DateTime?
  deletedById    String?
  deletedBy      User?     @relation("ActionDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deletionReason String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  raciAssignments RaciAssignment[]
  auditEvents     AuditEvent[]
  exceptions      Exception[]
  evidenceItems   EvidenceItem[]
  dataRequests    DataRequest[]
  approvals       Approval[]
  reminders       Reminder[]
  documentLinks   DocumentRecordLink[]   @relation("DocumentRecordLinkAction")
  reviewLinks     ReviewItemRecordLink[] @relation("ReviewItemRecordLinkAction")

  @@index([organisationId])
  @@index([entityId])
}

// ── Ownership, RACI & status controls ───────────────────────────

model Party {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  name               String
  email              String?
  organisationOrTeam String?
  partyType          String // Internal tax | Finance | Payroll | HR | Legal | Treasury | Company secretarial |
  // Share plan administrator | External tax adviser | External legal adviser | Auditor | Board/CFO | Other
  isExternal         Boolean @default(false)
  notes              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  raciAssignments RaciAssignment[]
  dataRequests    DataRequest[]

  @@index([organisationId])
}

model RaciAssignment {
